local Components = {}

function Components.toggle(parent, opts)
    local label = opts.label or "Toggle"
    local default = opts.default or false
    local onChanged = opts.onChanged or function() end

    local row = new("Frame", {
        Size = UDim2.new(1, 0, 0, 40),
        BackgroundColor3 = Theme.element,
        BorderSizePixel = 0,
    }, parent)
    corner(row, UDim.new(0, 6))

    new("TextLabel", {
        Size = UDim2.new(1, -70, 1, 0),
        Position = UDim2.new(0, 12, 0, 0),
        BackgroundTransparency = 1,
        Text = label,
        TextColor3 = Theme.text,
        TextSize = 12,
        Font = Enum.Font.GothamSemibold,
        TextXAlignment = Enum.TextXAlignment.Left,
    }, row)

    local track = new("Frame", {
        Size = UDim2.new(0, 42, 0, 22),
        Position = UDim2.new(1, -54, 0.5, -11),
        BackgroundColor3 = default and Theme.accent or Theme.hover,
        BorderSizePixel = 0,
    }, row)
    corner(track, UDim.new(1, 0))

    local knob = new("Frame", {
        Size = UDim2.new(0, 16, 0, 16),
        Position = default and UDim2.new(1, -19, 0.5, -8) or UDim2.new(0, 3, 0.5, -8),
        BackgroundColor3 = Theme.text,
        BorderSizePixel = 0,
    }, track)
    corner(knob, UDim.new(1, 0))

    local state = default
    local hitbox = new("TextButton", {
        Size = UDim2.new(1, 0, 1, 0),
        BackgroundTransparency = 1,
        Text = "",
    }, row)

    hitbox.MouseButton1Click:Connect(function()
        state = not state
        track.BackgroundColor3 = state and Theme.accent or Theme.hover
        knob.Position = state and UDim2.new(1, -19, 0.5, -8) or UDim2.new(0, 3, 0.5, -8)
        onChanged(state)
    end)

    return row, function() return state end
end

function Components.slider(parent, opts)
    local label = opts.label or "Slider"
    local min, max = opts.min or 0, opts.max or 100
    local default = opts.default or min
    local onChanged = opts.onChanged or function() end
    local suffix = opts.suffix or ""

    local row = new("Frame", {
        Size = UDim2.new(1, 0, 0, 56),
        BackgroundColor3 = Theme.element,
        BorderSizePixel = 0,
    }, parent)
    corner(row, UDim.new(0, 6))

    new("TextLabel", {
        Size = UDim2.new(1, -100, 0, 20),
        Position = UDim2.new(0, 12, 0, 8),
        BackgroundTransparency = 1,
        Text = label,
        TextColor3 = Theme.text,
        TextSize = 12,
        Font = Enum.Font.GothamSemibold,
        TextXAlignment = Enum.TextXAlignment.Left,
    }, row)

    local valueLabel = new("TextLabel", {
        Size = UDim2.new(0, 80, 0, 20),
        Position = UDim2.new(1, -92, 0, 8),
        BackgroundTransparency = 1,
        Text = tostring(default) .. suffix,
        TextColor3 = Theme.accent,
        TextSize = 12,
        Font = Enum.Font.GothamBold,
        TextXAlignment = Enum.TextXAlignment.Right,
    }, row)

    local bar = new("Frame", {
        Size = UDim2.new(1, -24, 0, 5),
        Position = UDim2.new(0, 12, 0, 38),
        BackgroundColor3 = Theme.hover,
        BorderSizePixel = 0,
    }, row)
    corner(bar, UDim.new(0, 3))

    local initialPct = (default - min) / math.max(max - min, 1)
    local fill = new("Frame", {
        Size = UDim2.new(initialPct, 0, 1, 0),
        BackgroundColor3 = Theme.accent,
        BorderSizePixel = 0,
    }, bar)
    corner(fill, UDim.new(0, 3))

    local knob = new("Frame", {
        Size = UDim2.new(0, 14, 0, 14),
        Position = UDim2.new(initialPct, -7, 0.5, -7),
        BackgroundColor3 = Theme.text,
        BorderSizePixel = 0,
    }, bar)
    corner(knob, UDim.new(1, 0))

    local dragging = false
    local function update(input)
        local rel = math.clamp((input.Position.X - bar.AbsolutePosition.X) / bar.AbsoluteSize.X, 0, 1)
        local value = math.floor(min + rel * (max - min) + 0.5)
        valueLabel.Text = tostring(value) .. suffix
        fill.Size = UDim2.new(rel, 0, 1, 0)
        knob.Position = UDim2.new(rel, -7, 0.5, -7)
        onChanged(value)
    end

    bar.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = true
            update(input)
        end
    end)
    Services.UserInputService.InputChanged:Connect(function(input)
        if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
            update(input)
        end
    end)
    Services.UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = false
        end
    end)

    return row
end

function Components.button(parent, opts)
    local label = opts.label or "Button"
    local onClick = opts.onClick or function() end

    local btn = new("TextButton", {
        Size = UDim2.new(1, 0, 0, 38),
        BackgroundColor3 = opts.color or Theme.element,
        BorderSizePixel = 0,
        Text = label,
        TextColor3 = Theme.text,
        TextSize = 12,
        Font = Enum.Font.GothamBold,
        AutoButtonColor = false,
    }, parent)
    corner(btn, UDim.new(0, 6))

    btn.MouseEnter:Connect(function()
        Services.TweenService:Create(btn, TweenInfo.new(0.12), {
            BackgroundColor3 = (opts.color or Theme.element):Lerp(Color3.new(1,1,1), 0.12)
        }):Play()
    end)
    btn.MouseLeave:Connect(function()
        Services.TweenService:Create(btn, TweenInfo.new(0.16), {
            BackgroundColor3 = opts.color or Theme.element
        }):Play()
    end)
    btn.MouseButton1Click:Connect(onClick)

    return btn
end

function Components.dropdown(parent, opts)
    local label = opts.label or "Dropdown"
    local items = opts.items or {}
    local default = opts.default or items[1]
    local onChanged = opts.onChanged or function() end

    local row = new("Frame", {
        Size = UDim2.new(1, 0, 0, 40),
        BackgroundColor3 = Theme.element,
        BorderSizePixel = 0,
        ClipsDescendants = false,
        ZIndex = 2,
    }, parent)
    corner(row, UDim.new(0, 6))

    new("TextLabel", {
        Size = UDim2.new(0.5, 0, 1, 0),
        Position = UDim2.new(0, 12, 0, 0),
        BackgroundTransparency = 1,
        Text = label,
        TextColor3 = Theme.text,
        TextSize = 12,
        Font = Enum.Font.GothamSemibold,
        TextXAlignment = Enum.TextXAlignment.Left,
        ZIndex = 3,
    }, row)

    local select = new("TextButton", {
        Size = UDim2.new(0, 120, 0, 26),
        Position = UDim2.new(1, -132, 0.5, -13),
        BackgroundColor3 = Theme.bg,
        BorderSizePixel = 0,
        Text = tostring(default),
        TextColor3 = Theme.text,
        TextSize = 11,
        Font = Enum.Font.GothamSemibold,
        ZIndex = 4,
    }, row)
    corner(select, UDim.new(0, 4))

    local popup = new("ScrollingFrame", {
        Size = UDim2.new(0, 160, 0, math.min(#items * 30, 180)),
        BackgroundColor3 = Theme.panel,
        BorderSizePixel = 0,
        ScrollBarThickness = 4,
        CanvasSize = UDim2.new(0, 0, 0, #items * 30),
        Visible = false,
        ZIndex = 100,
    }, self.gui)
    corner(popup)

    for i, item in ipairs(items) do
        local opt = new("TextButton", {
            Size = UDim2.new(1, -8, 0, 26),
            Position = UDim2.new(0, 4, 0, (i - 1) * 30 + 2),
            BackgroundColor3 = Theme.element,
            BorderSizePixel = 0,
            Text = tostring(item),
            TextColor3 = Theme.text,
            TextSize = 11,
            Font = Enum.Font.GothamSemibold,
            ZIndex = 101,
        }, popup)
        corner(opt, UDim.new(0, 4))
        opt.MouseButton1Click:Connect(function()
            select.Text = tostring(item)
            popup.Visible = false
            onChanged(item)
        end)
    end

    select.MouseButton1Click:Connect(function()
        popup.Visible = not popup.Visible
        if popup.Visible then
            local pos = select.AbsolutePosition
            popup.Position = UDim2.fromOffset(pos.X - 40, pos.Y + select.AbsoluteSize.Y + 4)
        end
    end)

    return row
end

function Components.label(parent, text, opts)
    opts = opts or {}
    local lbl = new("TextLabel", {
        Size = UDim2.new(1, 0, 0, opts.height or 24),
        BackgroundTransparency = 1,
        Text = text,
        TextColor3 = opts.color or Theme.textDim,
        TextSize = opts.size or 11,
        Font = opts.bold and Enum.Font.GothamBold or Enum.Font.Gotham,
        TextWrapped = true,
        TextXAlignment = Enum.TextXAlignment.Left,
    }, parent)
    return lbl
end

