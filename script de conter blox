local Hub = {}
Hub.__index = Hub

function Hub.new(opts)
    opts = opts or {}
    local self = setmetatable({}, Hub)
    self.title = opts.title or "Hub"
    self.store = Store.new(opts.configFile or "hub_config.json")
    self.modules = {}
    self.moduleOrder = {}
    self.activeModule = nil
    self.tabs = {}
    self.tabButtons = {}
    self.contentFrames = {}
    self.gui = nil
    self._build()
    return self
end

function Hub:_build()
    local gui = Instance.new("ScreenGui")
    gui.Name = "ModularHub"
    gui.ResetOnSpawn = false
    gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
    gui.DisplayOrder = 100
    gui.Parent = PlayerGui
    self.gui = gui

    local root = new("Frame", {
        Name = "Root",
        Size = UDim2.new(0, 720, 0, 460),
        Position = UDim2.new(0.5, -360, 0.5, -230),
        BackgroundColor3 = Theme.bg,
        BorderSizePixel = 0,
        Active = true,
    }, gui)
    self.root = root
    corner(root)
    stroke(root, Theme.border)

    -- título / barra de arrastar
    local titleBar = new("Frame", {
        Name = "TitleBar",
        Size = UDim2.new(1, 0, 0, 44),
        BackgroundColor3 = Theme.sidebar,
        BorderSizePixel = 0,
    }, root)
    corner(titleBar, UDim.new(0, 8))

    -- máscara pra arredondar só a parte de cima
    local titleMask = new("Frame", {
        Size = UDim2.new(1, 0, 0.5, 0),
        Position = UDim2.new(0, 0, 0.5, 0),
        BackgroundColor3 = Theme.sidebar,
        BorderSizePixel = 0,
    }, titleBar)

    new("TextLabel", {
        Size = UDim2.new(1, -120, 1, 0),
        Position = UDim2.new(0, 16, 0, 0),
        BackgroundTransparency = 1,
        Text = self.title,
        TextColor3 = Theme.text,
        TextSize = 17,
        Font = Enum.Font.GothamBold,
        TextXAlignment = Enum.TextXAlignment.Left,
    }, titleBar)

    local closeBtn = new("TextButton", {
        Size = UDim2.new(0, 28, 0, 28),
        Position = UDim2.new(1, -36, 0.5, -14),
        BackgroundColor3 = Theme.element,
        Text = "×",
        TextColor3 = Theme.text,
        TextSize = 18,
        Font = Enum.Font.GothamBold,
        BorderSizePixel = 0,
    }, titleBar)
    corner(closeBtn, UDim.new(0, 6))
    closeBtn.MouseButton1Click:Connect(function()
        gui.Enabled = false
    end)

    -- sidebar
    local sidebar = new("Frame", {
        Name = "Sidebar",
        Size = UDim2.new(0, 160, 1, -44),
        Position = UDim2.new(0, 0, 0, 44),
        BackgroundColor3 = Theme.sidebar,
        BorderSizePixel = 0,
    }, root)
    self.sidebar = sidebar

    self.sidebarLayout = Instance.new("UIListLayout")
    self.sidebarLayout.Padding = UDim.new(0, 6)
    self.sidebarLayout.SortOrder = Enum.SortOrder.LayoutOrder
    self.sidebarLayout.Parent = sidebar

    new("UIPadding", {
        PaddingTop = UDim.new(0, 8),
        PaddingLeft = UDim.new(0, 8),
        PaddingRight = UDim.new(0, 8),
    }, sidebar)

    -- área de conteúdo
    local content = new("Frame", {
        Name = "Content",
        Size = UDim2.new(1, -160, 1, -44),
        Position = UDim2.new(0, 160, 0, 44),
        BackgroundColor3 = Theme.bg,
        BorderSizePixel = 0,
    }, root)
    self.content = content

    self:_makeDraggable(titleBar)
    self:_makeResizable()
end

function Hub:_makeDraggable(handle)
    local dragging, dragStart, startPos = false, nil, nil
    handle.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = true
            dragStart = input.Position
            startPos = self.root.Position
        end
    end)
    Services.UserInputService.InputChanged:Connect(function(input)
        if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
            local delta = input.Position - dragStart
            self.root.Position = UDim2.new(
                startPos.X.Scale, startPos.X.Offset + delta.X,
                startPos.Y.Scale, startPos.Y.Offset + delta.Y
            )
        end
    end)
    Services.UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = false
        end
    end)
end

function Hub:_makeResizable()
    local grip = new("TextButton", {
        Size = UDim2.new(0, 16, 0, 16),
        Position = UDim2.new(1, -20, 1, -20),
        BackgroundTransparency = 1,
        Text = "◢",
        TextColor3 = Theme.textDim,
        TextSize = 12,
    }, self.root)

    local resizing, startPos, startSize = false, nil, nil
    grip.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            resizing = true
            startPos = input.Position
            startSize = self.root.Size
        end
    end)
    Services.UserInputService.InputChanged:Connect(function(input)
        if resizing and input.UserInputType == Enum.UserInputType.MouseMovement then
            local delta = input.Position - startPos
            self.root.Size = UDim2.new(
                0, math.clamp(startSize.X.Offset + delta.X, 560, 1100),
                0, math.clamp(startSize.Y.Offset + delta.Y, 380, 780)
            )
        end
    end)
    Services.UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            resizing = false
        end
    end)
end

