-- =============================================
-- FUNÇÕES DE ESP
-- =============================================
local function AddESP(Target)
    if ESPObjects[Target] then return end
    local Hum = Target:FindFirstChild("Humanoid")
    if not Hum or Hum.Health <= 0 then return end
    local Root = Target:FindFirstChild("HumanoidRootPart") or Target:FindFirstChild("Head")
    if not Root then return end

    local Highlight = Instance.new("Highlight")
    Highlight.Adornee = Target
    Highlight.FillColor = Settings.BoxColor
    Highlight.FillTransparency = 0.7
    Highlight.OutlineColor = Settings.BoxColor
    Highlight.OutlineTransparency = 0
    Highlight.Enabled = Settings.ShowHighlight
    Highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    Highlight.Parent = Target

    local Billboard = Instance.new("BillboardGui")
    Billboard.Adornee = Root
    Billboard.Size = UDim2.new(0, 100, 0, 20)
    Billboard.StudsOffset = Vector3.new(0, 2.5, 0)
    Billboard.AlwaysOnTop = true
    local NameLabel = Instance.new("TextLabel")
    NameLabel.Size = UDim2.new(1, 0, 1, 0)
    NameLabel.BackgroundTransparency = 1
    NameLabel.Text = Target.Name
    NameLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
    NameLabel.TextStrokeTransparency = 0
    NameLabel.Font = Enum.Font.GothamBold
    NameLabel.TextSize = 14
    NameLabel.Parent = Billboard
    Billboard.Parent = Target

    local Box = Drawing.new("Square")
    Box.Visible = false
    Box.Color = Settings.BoxColor
    Box.Thickness = Settings.Thickness
    Box.Filled = false

    local Tracer = Drawing.new("Line")
    Tracer.Visible = false
    Tracer.Color = Settings.TracerColor
    Tracer.Thickness = Settings.Thickness

    ESPObjects[Target] = {
        Highlight = Highlight, Billboard = Billboard, NameLabel = NameLabel,
        Box = Box, Tracer = Tracer, RootPart = Root, Target = Target
    }
end

local function RemoveESP(Target)
    local Obj = ESPObjects[Target]
    if Obj then
        if Obj.Highlight then Obj.Highlight:Destroy() end
        if Obj.Billboard then Obj.Billboard:Destroy() end
        if Obj.Box then Obj.Box:Remove() end
        if Obj.Tracer then Obj.Tracer:Remove() end
        ESPObjects[Target] = nil
    end
end

-- =============================================
-- DETECÇÃO DE TECLA
-- =============================================
UserInputService.InputBegan:Connect(function(Input, P)
    if P then return end
    if Input.KeyCode == Settings.AimKey then
        AimbotActive = true
    end
end)
UserInputService.InputEnded:Connect(function(Input, P)
    if P then return end
    if Input.KeyCode == Settings.AimKey then
        AimbotActive = false
    end
end)

ToggleBtn.MouseButton1Click:Connect(function()
    Settings.Enabled = not Settings.Enabled
    ToggleBtn.Text = Settings.Enabled and "ESP: ON" or "ESP: OFF"
    ToggleBtn.BackgroundColor3 = Settings.Enabled and Color3.fromRGB(0, 150, 0) or Color3.fromRGB(150, 0, 0)
    if not Settings.Enabled then
        for _, o in pairs(ESPObjects) do
            if o.Highlight then o.Highlight:Destroy() end
            if o.Box then o.Box:Remove() end
            if o.Tracer then o.Tracer:Remove() end
            if o.Billboard then o.Billboard:Destroy() end
        end
        table.clear(ESPObjects)
    end
end)

-- =============================================
-- LOOP PRINCIPAL
-- =============================================
CreateFOVCircle()
local lastScan = 0

RunService.RenderStepped:Connect(function()
    -- Atualizar FOV visual
    if FOVCircle and Settings.ShowFOVCircle then
        FOVCircle.Position = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
        FOVCircle.Visible = Settings.Enabled
    end

    -- Aimbot rodando
    if AimbotActive and Settings.AimEnabled and Settings.Enabled then
        local Alvo = GetClosestAimTarget()
        AimAt(Alvo)
    end

    if not Settings.Enabled then return end

    -- Atualizar ESP
    for Target, Obj in pairs(ESPObjects) do
        if not Target.Parent or not Target:FindFirstChild("Humanoid") or Target.Humanoid.Health <= 0 then
            RemoveESP(Target)
            continue
        end
        local Dist = 9999
        local LRoot = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
        if LRoot and Obj.RootPart then
            Dist = (LRoot.Position - Obj.RootPart.Position).Magnitude
        end
        if Dist > Settings.MaxDistance then
            Obj.Box.Visible = false
            Obj.Tracer.Visible = false
            Obj.NameLabel.Visible = false
            Obj.Highlight.Enabled = false
            continue
        else
            Obj.Highlight.Enabled = Settings.ShowHighlight
            Obj.NameLabel.Visible = Settings.ShowName
        end
        local Pos, OnScreen = Camera:WorldToViewportPoint(Obj.RootPart.Position)
        if OnScreen then
            local Dm = (Camera.CFrame.Position - Obj.RootPart.Position).Magnitude
            local Sz = Target:GetExtentsSize()
            local Bh = Sz.Y * (Camera.ViewportSize.Y / Dm) * 10
            local Bw = Bh * 0.6
            if Settings.ShowBox then
                Obj.Box.Size = Vector2.new(Bw, Bh)
                Obj.Box.Position = Vector2.new(Pos.X - Bw/2, Pos.Y - Bh/2)
                Obj.Box.Visible = true
            else
                Obj.Box.Visible = false
            end
            if Settings.ShowTracer then
                Obj.Tracer.From = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y)
                Obj.Tracer.To = Vector2.new(Pos.X, Pos.Y)
                Obj.Tracer.Visible = true
            else
                Obj.Tracer.Visible = false
            end
        else
            Obj.Box.Visible = false
            Obj.Tracer.Visible = false
        end
    end

    -- Escanear jogadores
    local now = os.clock()
    if now - lastScan > 0.5 then
        lastScan = now
        for _, Plr in ipairs(Players:GetPlayers()) do
            if Plr ~= LocalPlayer and Plr.Character then
                if IsEnemy(Plr.Character) then
                    AddESP(Plr.Character)
                else
                    RemoveESP(Plr.Character)
                end
            end
        end
    end
end)
