-- =============================================
-- FUNÇÃO DE INIMIGO
-- =============================================
local function IsEnemy(Target)
    if not Settings.TeamCheck then return true end
    if not Target or not Target:IsA("Model") then return false end
    local Humanoid = Target:FindFirstChild("Humanoid")
    if not Humanoid or Humanoid.Health <= 0 then return false end
    local PlayerCheck = Players:GetPlayerFromCharacter(Target)
    if PlayerCheck then
        return PlayerCheck ~= LocalPlayer and PlayerCheck.Team ~= LocalPlayer.Team
    end
    return true
end

-- =============================================
-- DESENHAR CÍRCULO DE FOV
-- =============================================
local function CreateFOVCircle()
    FOVCircle = Drawing.new("Circle")
    FOVCircle.Radius = Settings.FOV
    FOVCircle.Thickness = 1
    FOVCircle.Filled = false
    FOVCircle.NumSides = 64
    FOVCircle.Color = Color3.fromRGB(255, 255, 255)
    FOVCircle.Transparency = 1
    FOVCircle.Visible = Settings.ShowFOVCircle
end

-- =============================================
-- SISTEMA DE AIMBOT
-- =============================================
local function GetClosestAimTarget()
    local BestTarget = nil
    local BestAngle = math.huge
    local LocalChar = LocalPlayer.Character
    if not LocalChar then return nil end
    local Root = LocalChar:FindFirstChild("HumanoidRootPart")
    local Head = LocalChar:FindFirstChild("Head")
    if not Root or not Head then return nil end

    local CameraCF = Camera.CFrame
    local ScreenCenter = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)

    for _, Player in ipairs(Players:GetPlayers()) do
        if Player ~= LocalPlayer and Player.Character then
            local Char = Player.Character
            local Hum = Char:FindFirstChild("Humanoid")
            local Part = Char:FindFirstChild(Settings.AimPart)
            local OtherRoot = Char:FindFirstChild("HumanoidRootPart")
            if Hum and Hum.Health > 0 and Part and OtherRoot and IsEnemy(Char) then
                local Dist = (Root.Position - OtherRoot.Position).Magnitude
                if Dist <= Settings.AimDistance then
                    local Pos, OnScreen = Camera:WorldToViewportPoint(Part.Position)
                    if OnScreen then
                        local Vec2 = Vector2.new(Pos.X, Pos.Y)
                        local Angle = (Vec2 - ScreenCenter).Magnitude
                        if Angle < Settings.FOV and Angle < BestAngle then
                            BestAngle = Angle
                            BestTarget = Part
                        end
                    end
                end
            end
        end
    end
    return BestTarget
end

local function AimAt(TargetPart)
    if not TargetPart then return end
    local CamPos = Camera.CFrame.Position
    local Direction = (TargetPart.Position - CamPos).Unit
    local NewCF = CFrame.new(CamPos, CamPos + Direction)
    Camera.CFrame = Camera.CFrame:Lerp(NewCF, 1 / Settings.Smoothness)
end

