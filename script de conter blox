function Hub:register(module)
    assert(module.name, "module.name obrigatório")
    assert(module.build, "module.build obrigatório")

    self.modules[module.name] = module
    table.insert(self.moduleOrder, module.name)

    local btn = new("TextButton", {
        Name = "Tab_" .. module.name,
        Size = UDim2.new(1, 0, 0, 36),
        BackgroundColor3 = Theme.element,
        BorderSizePixel = 0,
        Text = "",
        AutoButtonColor = false,
    }, self.sidebar)
    corner(btn, UDim.new(0, 6))

    local iconLabel = new("TextLabel", {
        Size = UDim2.new(0, 24, 1, 0),
        Position = UDim2.new(0, 8, 0, 0),
        BackgroundTransparency = 1,
        Text = module.icon or "•",
        TextColor3 = Theme.textDim,
        TextSize = 14,
        Font = Enum.Font.GothamBold,
    }, btn)

    local nameLabel = new("TextLabel", {
        Size = UDim2.new(1, -36, 1, 0),
        Position = UDim2.new(0, 32, 0, 0),
        BackgroundTransparency = 1,
        Text = module.name,
        TextColor3 = Theme.text,
        TextSize = 12,
        Font = Enum.Font.GothamSemibold,
        TextXAlignment = Enum.TextXAlignment.Left,
    }, btn)

    -- container de conteúdo da aba
    local frame = new("Frame", {
        Name = "Content_" .. module.name,
        Size = UDim2.new(1, 0, 1, 0),
        BackgroundTransparency = 1,
        Visible = false,
    }, self.content)

    local scroll = new("ScrollingFrame", {
        Size = UDim2.new(1, -24, 1, -24),
        Position = UDim2.new(0, 12, 0, 12),
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        ScrollBarThickness = 4,
        ScrollBarImageColor3 = Theme.accent,
        CanvasSize = UDim2.new(0, 0, 0, 0),
        AutomaticCanvasSize = Enum.AutomaticSize.Y,
    }, frame)

    local layout = Instance.new("UIListLayout")
    layout.Padding = UDim.new(0, 8)
    layout.SortOrder = Enum.SortOrder.LayoutOrder
    layout.Parent = scroll

    frame.scroll = scroll

    self.tabs[module.name] = frame
    self.tabButtons[module.name] = { button = btn, icon = iconLabel, label = nameLabel }

    btn.MouseButton1Click:Connect(function()
        self:activate(module.name)
    end)
    btn.MouseEnter:Connect(function()
        if self.activeModule ~= module.name then
            btn.BackgroundColor3 = Theme.hover
        end
    end)
    btn.MouseLeave:Connect(function()
        if self.activeModule ~= module.name then
            btn.BackgroundColor3 = Theme.element
        end
    end)

    -- constrói o conteúdo uma vez
    module.build(scroll, self)

    -- ativa o primeiro
    if #self.moduleOrder == 1 then
        self:activate(module.name)
    end
end

function Hub:activate(name)
    if self.activeModule == name then return end

    if self.activeModule then
        local prev = self.modules[self.activeModule]
        if prev and prev.onDeactivate then
            pcall(prev.onDeactivate, self)
        end
        local prevTab = self.tabs[self.activeModule]
        local prevBtn = self.tabButtons[self.activeModule]
        if prevTab then prevTab.Visible = false end
        if prevBtn then
            prevBtn.button.BackgroundColor3 = Theme.element
            prevBtn.icon.TextColor3 = Theme.textDim
        end
    end

    self.activeModule = name
    local tab = self.tabs[name]
    local btnRef = self.tabButtons[name]
    if tab then tab.Visible = true end
    if btnRef then
        btnRef.button.BackgroundColor3 = Theme.accentDim
        btnRef.icon.TextColor3 = Theme.text
    end

    local module = self.modules[name]
    if module and module.onActivate then
        pcall(module.onActivate, self)
    end
end

