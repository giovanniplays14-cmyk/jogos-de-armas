-- ============================================================
-- CONFIG / PERSISTÊNCIA
-- ============================================================
local Store = {}
Store.__index = Store

function Store.new(filename)
    local self = setmetatable({}, Store)
    self.filename = filename or "hub_config.json"
    self.data = {}
    self:_load()
    return self
end

function Store:_load()
    local ok, raw = pcall(function()
        if isfile and isfile(self.filename) then
            return readfile(self.filename)
        end
        return nil
    end)
    if ok and raw and #raw > 0 then
        local decoded = pcall(function()
            return Services.HttpService:JSONDecode(raw)
        end)
        if decoded then
            self.data = Services.HttpService:JSONDecode(raw)
        end
    end
end

function Store:get(key, default)
    if self.data[key] == nil then return default end
    return self.data[key]
end

function Store:set(key, value)
    self.data[key] = value
    self:_save()
end

function Store:_save()
    pcall(function()
        if writefile then
            writefile(self.filename, Services.HttpService:JSONEncode(self.data))
        end
    end)
end

function Store:reset()
    self.data = {}
    pcall(function()
        if delfile and isfile and isfile(self.filename) then
            delfile(self.filename)
        end
    end)
end

