    if input.UserInputType == Enum.UserInputType.MouseButton1 then IsShooting = false; LockedTarget = nil end
    if input.KeyCode == Enum.KeyCode.F then
        if AimAssist.ShootToActivate then IsShooting = false; LockedTarget = nil
        else AimAssist.Enabled = false; LockedTarget = nil end
    end
end)

