-- ==================== SKILL KEYS PARSER (COM NÚMEROS) ====================
local DigitMap = {
    ["1"] = Enum.KeyCode.One,
    ["2"] = Enum.KeyCode.Two,
    ["3"] = Enum.KeyCode.Three,
    ["4"] = Enum.KeyCode.Four,
    ["5"] = Enum.KeyCode.Five,
    ["6"] = Enum.KeyCode.Six,
    ["7"] = Enum.KeyCode.Seven,
    ["8"] = Enum.KeyCode.Eight,
    ["9"] = Enum.KeyCode.Nine,
    ["0"] = Enum.KeyCode.Zero,
}

local function ParseSkillKeys(str)
    local keys = {}
    for token in string.gmatch(str, "[^,%s]+") do
        local upper = string.upper(token)
        local keyCode = DigitMap[upper] or Enum.KeyCode[upper]
        if keyCode then
            table.insert(keys, keyCode)
        end
    end
    return keys
end

local function SpamAllSkills()
    local keys = ParseSkillKeys(Skills.SkillKeysStr)
    for _, keyCode in ipairs(keys) do
        pcall(function()
            VirtualInputManager:SendKeyEvent(true, keyCode, false, game)
            task.wait(0.005)
            VirtualInputManager:SendKeyEvent(false, keyCode, false, game)
        end)
    end
end

local function StartNoCooldownLoop()
    if Skills.LoopThread then
        pcall(function() task.cancel(Skills.LoopThread) end)
        Skills.LoopThread = nil
    end
    Skills.LoopThread = task.spawn(function()
        while Skills.NoCooldownEnabled do
            pcall(SpamAllSkills)
            task.wait(math.max(0.05, Skills.CooldownInterval))
        end
        Skills.LoopThread = nil
    end)
end

local function StopNoCooldownLoop()
    Skills.NoCooldownEnabled = false
    if Skills.LoopThread then
        pcall(function() task.cancel(Skills.LoopThread) end)
        Skills.LoopThread = nil
    end
end

local function SetNoCooldownState(enabled)
    Skills.NoCooldownEnabled = enabled
    if enabled then
        StartNoCooldownLoop()
    else
        StopNoCooldownLoop()
    end
    return enabled
end

