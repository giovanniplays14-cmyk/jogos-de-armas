    if has then return sp end
    if AimAssist.LowestHealthPriority then LockedTarget = nil; return GetPlayerWithLowestHealth()
    elseif AimAssist.PriorityMode == "Distance" then return GetClosestPlayerByDistance()
    else return GetClosestPlayerByFOV() end
end

local function ApplyAimAssist()
    local should = AimAssist.AlwaysOn or (AimAssist.Enabled and (not AimAssist.ShootToActivate or IsShooting))
    if not should then CurrentTarget = nil; return end
    if not LocalPlayer.Character then return end
    local myHum = LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
    if not myHum or myHum.Health <= 0 then return end
    CurrentTarget = GetClosestPlayer()
    if CurrentTarget and CurrentTarget.Character then
        local tp = GetTargetPart(CurrentTarget.Character)
        if tp then
            local targetPos = tp.Position
            if tp.Name == "Head" then targetPos = targetPos + Vector3.new(0, 0.75, 0) end
            local ccf = Camera.CFrame
            local tcf
            if AimAssist.AimReference == "Cursor" then
                local mp = UserInputService:GetMouseLocation()
                local ray = Camera:ScreenPointToRay(mp.X, mp.Y)
                local dr = ray.Direction.Unit
                local td = (targetPos - ccf.Position).Unit
                local dot = math.clamp(dr:Dot(td), -1, 1)
                local axis = dr:Cross(td)
                if axis.Magnitude > 1e-5 then
                    local rd = CFrame.fromAxisAngle(axis.Unit, math.acos(dot))
                    local cr = ccf - ccf.Position
                    tcf = CFrame.new(ccf.Position) * rd * cr
                else
                    tcf = ccf
                end
            else
                tcf = CFrame.lookAt(ccf.Position, targetPos)
            end
            local ok, sp = pcall(function() return Camera:WorldToViewportPoint(targetPos) end)
            if ok then
                local ar = GetAimReferencePoint()
                local dfc = (Vector2.new(sp.X, sp.Y) - ar).Magnitude
                local smooth
                if dfc < 25 then smooth = AimAssist.SnapSmoothness
                elseif dfc < 80 then smooth = 0.92
                elseif AimAssist.MagnetMode then smooth = 0.88
                else smooth = AimAssist.Smoothness end
                Camera.CFrame = ccf:Lerp(tcf, smooth)
            end
        end
    else
        LockedTarget = nil
    end
end

local function UpdateESP()
    if not LocalPlayer.Character then return end
    local myRoot = LocalPlayer.Character:FindFirstChild("HumanoidRootPart") or LocalPlayer.Character:FindFirstChild("Torso")
    if not myRoot then return end
    local vc = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
    local inset = GuiService:GetGuiInset()
    local cp = AimAssist.AimReference == "Cursor" and UserInputService:GetMouseLocation() or (vc + Vector2.new(inset.X, inset.Y))
    if FOV_Circle then
        local show = AimAssist.AlwaysOn or (AimAssist.Enabled and (IsShooting or not AimAssist.ShootToActivate))
        FOV_Circle.Visible = show
        FOV_Circle.Position = cp
        if AimAssist.PriorityMode == "Distance" then FOV_Circle.Radius = AimAssist.MaxFOVForDistance; FOV_Circle.Color = Color3.fromRGB(0, 200, 255)
        else FOV_Circle.Radius = AimAssist.FOV; FOV_Circle.Color = Colors.Accent end
        if CurrentTarget and IsShooting then FOV_Circle.Thickness = 2.5; FOV_Circle.Color = Color3.fromRGB(255, 50, 50)
        elseif CurrentTarget then FOV_Circle.Thickness = 2; FOV_Circle.Color = Color3.fromRGB(255, 200, 50)
        else FOV_Circle.Thickness = 1.5; FOV_Circle.Color = Color3.fromRGB(100, 100, 100) end
    end
    for player, d in pairs(ESPObjects) do
        pcall(function()
            if not ESP.Enabled then for _, v in pairs(d) do if v then v.Visible = false end end; return end
            local char = player.Character
            if not char then for _, v in pairs(d) do if v then v.Visible = false end end; return end
            if ESP.TeamCheck and IsTeammate(player) then for _, v in pairs(d) do if v then v.Visible = false end end; return end
            local hum = char:FindFirstChildOfClass("Humanoid")
            local rp = char:FindFirstChild("HumanoidRootPart") or char:FindFirstChild("Torso")
            if not hum or not rp or hum.Health <= 0 then for _, v in pairs(d) do if v then v.Visible = false end end; return end
            local rpos, on = Camera:WorldToViewportPoint(rp.Position)
            local dist = (myRoot.Position - rp.Position).Magnitude
            if not on or dist > ESP.MaxDistance then for _, v in pairs(d) do if v then v.Visible = false end end; return end
            local size = math.clamp(2500 / rpos.Z, 15, 180)
            local w = size * 0.65
            local h = size * 1.4
            if ESP.Boxes and d.Box then
                d.Box.Size = Vector2.new(w, h)
                d.Box.Position = Vector2.new(rpos.X - w/2, rpos.Y - h/2)
                d.Box.Visible = true
                if player == CurrentTarget then
                    if IsShooting then d.Box.Color = Color3.fromRGB(255, 50, 50); d.Box.Thickness = 3
                    else d.Box.Color = AimAssist.MagnetMode and Color3.fromRGB(255, 100, 255) or Color3.fromRGB(255, 200, 50); d.Box.Thickness = 2.5 end
                    d.Box.Filled = true; d.Box.Transparency = 0.25
                else
                    d.Box.Color = ESP.BoxColor; d.Box.Thickness = 2; d.Box.Filled = false; d.Box.Transparency = 1
                end
            elseif d.Box then d.Box.Visible = false end
            if ESP.Tracers and d.Tracer then
                d.Tracer.From = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y)
                d.Tracer.To = Vector2.new(rpos.X, rpos.Y + h/2)
                d.Tracer.Visible = true
                d.Tracer.Color = (player == CurrentTarget) and Color3.fromRGB(255, 200, 50) or ESP.BoxColor
            elseif d.Tracer then d.Tracer.Visible = false end
            if ESP.Names and d.Name then
                d.Name.Text = player.Name .. (player == CurrentTarget and (IsShooting and " [FIRING]" or " [TARGET]") or "")
                d.Name.Position = Vector2.new(rpos.X, rpos.Y - h/2 - 18)
                d.Name.Visible = true
                d.Name.Color = (player == CurrentTarget) and (IsShooting and Color3.fromRGB(255, 50, 50) or Color3.fromRGB(255, 200, 50)) or ESP.TextColor
                d.Name.Size = (player == CurrentTarget) and 15 or ESP.TextSize
            elseif d.Name then d.Name.Visible = false end
            if ESP.Distances and d.Distance then
                d.Distance.Text = math.floor(dist) .. "m"
                d.Distance.Position = Vector2.new(rpos.X, rpos.Y + h/2 + 6)
                d.Distance.Visible = true
            elseif d.Distance then d.Distance.Visible = false end
            if ESP.HealthBar and d.HealthBar and d.HealthBarBg then
                local hp = math.clamp(hum.Health / hum.MaxHealth, 0, 1)
                local bh = h * 0.8
                local bw = 4
                d.HealthBarBg.Size = Vector2.new(bw, bh)
                d.HealthBarBg.Position = Vector2.new(rpos.X - w/2 - 10, rpos.Y - h/2 + (h - bh)/2)
                d.HealthBarBg.Visible = true
                d.HealthBar.Size = Vector2.new(bw, bh * hp)
                d.HealthBar.Position = Vector2.new(rpos.X - w/2 - 10, rpos.Y - h/2 + (h - bh)/2 + bh * (1 - hp))
                d.HealthBar.Color = Color3.fromRGB(255 * (1 - hp), 255 * hp, 50)
                d.HealthBar.Visible = true
            else
                if d.HealthBar then d.HealthBar.Visible = false end
                if d.HealthBarBg then d.HealthBarBg.Visible = false end
            end
        end)
    end
end

