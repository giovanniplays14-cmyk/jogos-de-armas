            clearBtn.Parent = r
            CreateCorner(clearBtn, UDim.new(0, 5))

            local b = Instance.new("TextButton")
            b.Size = UDim2.new(0, 125, 0, 28)
            b.Position = UDim2.new(1, -135, 0.5, -14)
            b.BackgroundColor3 = Colors.Background
            b.BorderSizePixel = 0
            b.Text = "DEFINIR TECLA"
            b.TextColor3 = Colors.Text
            b.TextSize = 10
            b.Font = Enum.Font.GothamBold
            b.Parent = r
            CreateCorner(b, UDim.new(0, 5))

            ShortcutBindings[key] = {
                Ref = ref, Button = b, ClearButton = clearBtn, Key = nil, Waiting = false,
                Apply = ref.Apply, Get = ref.Get, Set = ref.Set, Type = ref.Type or "toggle"
            }

            b.MouseButton1Click:Connect(function()
                for _, e in pairs(ShortcutBindings) do e.Waiting = false end
                ShortcutBindings[key].Waiting = true
                b.Text = "PRESSIONE..."
                shortcutStatus.Text = ""
            end)

            clearBtn.MouseButton1Click:Connect(function()
                local e = ShortcutBindings[key]
                if e then
                    e.Key = nil; e.Waiting = false; e.Button.Text = "DEFINIR TECLA"
                    shortcutStatus.Text = "Atalho removido: " .. (ref.Label or key)
                    shortcutStatus.TextColor3 = Colors.Success
                    task.delay(2, function()
                        if shortcutStatus and shortcutStatus.Parent then shortcutStatus.Text = "" end
                    end)
                end
            end)
        end

        local allKeys = {}
        for k in pairs(UIRefs.Toggles) do table.insert(allKeys, k) end
        for k in pairs(UIRefs.Actions) do table.insert(allKeys, k) end
        table.sort(allKeys)
        for _, k in ipairs(allKeys) do
            local ref = UIRefs.Toggles[k] or UIRefs.Actions[k]
            AddRow(k, ref)
        end

        UserInputService.InputBegan:Connect(function(input, gp)
            if input.UserInputType ~= Enum.UserInputType.Keyboard then return end
            for key, e in pairs(ShortcutBindings) do
                if e.Waiting then
                    e.Waiting = false
                    if input.KeyCode == Enum.KeyCode.Backspace or input.KeyCode == Enum.KeyCode.Delete then
                        e.Key = nil; e.Button.Text = "DEFINIR TECLA"; shortcutStatus.Text = ""
                    elseif input.KeyCode == Enum.KeyCode.Escape then
                        e.Button.Text = e.Key and e.Key.Name or "DEFINIR TECLA"; shortcutStatus.Text = ""
                    elseif input.KeyCode ~= Enum.KeyCode.Unknown then
                        if IsKeySkillKey(input.KeyCode) then
                            e.Button.Text = e.Key and e.Key.Name or "DEFINIR TECLA"
                            shortcutStatus.Text = "Tecla bloqueada: já é usada pelo NC de Skills"
                            shortcutStatus.TextColor3 = Colors.Warning
                        else
                            e.Key = input.KeyCode; e.Button.Text = input.KeyCode.Name; shortcutStatus.Text = ""
                        end
                    end
                    return
                end
            end
            if gp then return end
            if IsKeySkillKey(input.KeyCode) then return end
            for _, e in pairs(ShortcutBindings) do
                if e.Key == input.KeyCode then
                    if e.Type == "cycle" then
                        local nv = e.Set and e.Set()
                        if e.Apply and nv ~= nil then e.Apply(nv) end
                    elseif e.Type == "action" then
                        if e.Apply then e.Apply() end
                    else
                        local ns = not e.Ref.Get()
                        e.Ref.Set(ns)
                        if e.Apply then e.Apply(ns) end
                    end
                    SaveCurrentConfig()
                end
            end
        end)

        -- SETTINGS TAB
        local st = TabContents["Settings"]
        local saveB = Instance.new("TextButton")
        saveB.Size = UDim2.new(1, 0, 0, 40)
        saveB.BackgroundColor3 = Colors.Accent
        saveB.BorderSizePixel = 0
        saveB.Text = "SALVAR CONFIGURAÇÃO"
        saveB.TextColor3 = Colors.Text
        saveB.TextSize = 14
        saveB.Font = Enum.Font.GothamBold
        saveB.Parent = st
        CreateCorner(saveB, UDim.new(0, 6))
        saveB.MouseButton1Click:Connect(function()
            SaveCurrentConfig()
            saveB.Text = "SALVO!"
            task.wait(1)
            saveB.Text = "SALVAR CONFIGURAÇÃO"
        end)

        local resetB = Instance.new("TextButton")
        resetB.Size = UDim2.new(1, 0, 0, 40)
        resetB.BackgroundColor3 = Color3.fromRGB(180, 40, 40)
        resetB.BorderSizePixel = 0
        resetB.Text = "RESTAURAR PADRÃO"
        resetB.TextColor3 = Colors.Text
        resetB.TextSize = 14
        resetB.Font = Enum.Font.GothamBold
        resetB.Parent = st
        CreateCorner(resetB, UDim.new(0, 6))
        resetB.MouseButton1Click:Connect(function()
            SaveSystem:Reset()
            resetB.Text = "RESTAURADO! ENTRE NOVAMENTE"
            task.wait(2)
            resetB.Text = "RESTAURAR PADRÃO"
        end)

        local unloadB = Instance.new("TextButton")
        unloadB.Size = UDim2.new(1, 0, 0, 40)
        unloadB.BackgroundColor3 = Color3.fromRGB(180, 40, 40)
        unloadB.BorderSizePixel = 0
        unloadB.Text = "DESCARREGAR SCRIPT"
        unloadB.TextColor3 = Colors.Text
        unloadB.TextSize = 14
        unloadB.Font = Enum.Font.GothamBold
        unloadB.Parent = st
        CreateCorner(unloadB, UDim.new(0, 6))
        unloadB.MouseButton1Click:Connect(function()
            Movement.Enabled = false
            ToggleFly(false)
            StopNoCooldownLoop()
            RestoreGraphics()
            DisableFastInput()
            RestoreInput()
            DisableNoAttackAnim()
            ScreenGui:Destroy()
            Env.ESPMokuroRunning = nil
            if Connection then Connection:Disconnect() end
            if FOV_Circle then FOV_Circle:Remove() end
            for _, obj in pairs(ESPObjects) do
                for _, d in pairs(obj) do if d then pcall(function() d:Remove() end) end end
            end
        end)

        local dragging = false
        local dragStart = nil
        local startPos = nil
        TitleBar.InputBegan:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 then
                dragging = true; dragStart = input.Position; startPos = MainFrame.Position
            end
        end)
        UserInputService.InputChanged:Connect(function(input)
            if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
                local d = input.Position - dragStart
                MainFrame.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + d.X, startPos.Y.Scale, startPos.Y.Offset + d.Y)
            end
        end)
        UserInputService.InputEnded:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 then dragging = false end
        end)

        UserInputService.InputBegan:Connect(function(input, gp)
            if input.KeyCode == Enum.KeyCode.Insert then
                if ScreenGui and ScreenGui.Parent then ScreenGui.Enabled = not ScreenGui.Enabled end
                return
            end
            if gp then return end
            if Movement.InfiniteJump and input.KeyCode == Enum.KeyCode.Space then
                local ch = LocalPlayer.Character
                if ch then
                    local hum = ch:FindFirstChildOfClass("Humanoid")
                    if hum then hum:ChangeState(Enum.HumanoidStateType.Jumping) end
                end
            end
        end)

        UserInputService.InputBegan:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 and openDropdown and openDropdown.Visible then
                local p, sz = openDropdown.AbsolutePosition, openDropdown.AbsoluteSize
                local m = UserInputService:GetMouseLocation()
                if m.X < p.X or m.X > p.X + sz.X or m.Y < p.Y or m.Y > p.Y + sz.Y then
                    openDropdown.Visible = false
                    openDropdown = nil
                end
            end
        end)
    end)
    if not success then warn("[Mokuro Hub] Error: " .. tostring(err)) end
end

