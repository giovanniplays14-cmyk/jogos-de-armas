function SaveSystem:Load()
    local success, result = pcall(function()
        if readfile then
            local data = readfile(self.ConfigName .. ".json")
            return HttpService:JSONDecode(data)
        end
        return nil
    end)
    
    if success and result then
        print("[Sistema de salvamento] Configuração carregada com sucesso")
        return result
    else
        print("[Sistema de salvamento] Usando configuração padrão")
        return self.DefaultConfig
    end
end

function SaveSystem:Save(config)
    pcall(function()
        if writefile then
            writefile(self.ConfigName .. ".json", HttpService:JSONEncode(config))
            print("[Sistema de salvamento] Configuração salva")
        end
    end)
end

function SaveSystem:Reset()
    pcall(function()
        if delfile then
            delfile(self.ConfigName .. ".json")
        end
    end)
    print("[Sistema de salvamento] Configuração restaurada")
    return self.DefaultConfig
end

