-- ==================== NO ATTACK ANIMATION (SAFE HOOKS) ====================
local AttackAnimKeywords = {
    "attack", "slash", "punch", "kick", "combo", "m1", "m2",
    "skill", "swing", "strike", "hit", "melee", "sword", "gun",
    "atk", "shoot", "cast", "dash", "dodge", "barrage", "blast",
    "claw", "bite", "flame", "ice", "lightning", "dark",
}

local function IsAttackAnimation(animName)
    local lower = string.lower(animName or "")
    for _, kw in ipairs(AttackAnimKeywords) do
        if string.find(lower, kw, 1, true) then return true end
    end
    return false
end

local function IsAttackTrack(track)
    if not track then return false end
    local result = false
    pcall(function()
        local anim = track.Animation
        if anim then
            local name = anim.Name or ""
            local id = anim.AnimationId or ""
            if IsAttackAnimation(name) or IsAttackAnimation(id) then result = true end
        end
    end)
    return result
end

local function MakeFakeTrack(animation)
    return {
        Play = function() end,
        Stop = function() end,
        AdjustSpeed = function() end,
        AdjustWeight = function() end,
        Destroy = function() end,
        Animation = animation,
        IsPlaying = false,
        Length = 0,
        TimePosition = 0,
        Speed = 1,
        WeightCurrent = 0,
        WeightTarget = 0,
        Priority = Enum.AnimationPriority.Idle,
        KeyframeReached = { Connect = function() return { Disconnect = function() end } end },
        Stopped = { Connect = function() return { Disconnect = function() end } end },
        DidLoop = { Connect = function() return { Disconnect = function() end } end },
    }
end

local function SafeWrap(wrapper)
    if newcclosure then
        local ok, result = pcall(newcclosure, wrapper)
        if ok and result then return result end
    end
    return wrapper
end

local function HookAnimatorInstance(animator)
    if not animator or Performance.HookedAnimators[animator] then return end
    Performance.HookedAnimators[animator] = true
    pcall(function()
        local originalLoad = animator.LoadAnimation
        if not originalLoad then return end
        local wrapper = function(self, animation)
            if Performance.NoAttackAnimEnabled then
                local name = ""
                pcall(function() name = animation and animation.Name or "" end)
                if IsAttackAnimation(name) then return MakeFakeTrack(animation) end
            end
            return originalLoad(self, animation)
        end
        animator.LoadAnimation = SafeWrap(wrapper)
    end)
end

local function HookHumanoid(hum)
    if not hum then return end
    pcall(function()
        if hum.LoadAnimation and not hum._MokuroHooked then
            hum._MokuroHooked = true
            local oldLoad = hum.LoadAnimation
            local wrapper = function(self, animation)
                if Performance.NoAttackAnimEnabled then
                    local name = ""
                    pcall(function() name = animation and animation.Name or "" end)
                    if IsAttackAnimation(name) then return MakeFakeTrack(animation) end
                end
                return oldLoad(self, animation)
            end
            hum.LoadAnimation = SafeWrap(wrapper)
        end
    end)
    pcall(function()
        local animator = hum:FindFirstChildOfClass("Animator")
        if animator then
            HookAnimatorInstance(animator)
        else
            hum.ChildAdded:Connect(function(child)
                if child:IsA("Animator") and Performance.NoAttackAnimEnabled then
                    HookAnimatorInstance(child)
                end
            end)
        end
    end)
end

local function HookTrack(track)
    if not track or Performance.HookedTracks[track] then return end
    Performance.HookedTracks[track] = true
    pcall(function()
        local oldPlay = track.Play
        if not oldPlay then return end
        local wrapper = function(self, ...)
            if Performance.NoAttackAnimEnabled and IsAttackTrack(track) then
                return
            end
            return oldPlay(self, ...)
        end
        track.Play = SafeWrap(wrapper)
    end)
end

local function StartCleanLoop()
    if Performance.CleanLoopThread then
        pcall(function() task.cancel(Performance.CleanLoopThread) end)
    end
    Performance.CleanLoopThread = task.spawn(function()
        while Performance.NoAttackAnimEnabled do
            pcall(function()
                local char = LocalPlayer.Character
                if char then
                    local hum = char:FindFirstChildOfClass("Humanoid")
                    if hum then
                        local animator = hum:FindFirstChildOfClass("Animator")
                        if animator then
                            for _, track in ipairs(animator:GetPlayingAnimationTracks()) do
                                HookTrack(track)
                                if IsAttackTrack(track) then
                                    pcall(function()
                                        track:Stop(0)
                                        track:Destroy()
                                    end)
                                end
                            end
                        end
                    end
                end
            end)
            task.wait(0.03)
        end
    end)
end

local function SetupAttackAnimHook()
    pcall(function()
        local char = LocalPlayer.Character
        if not char then return end
        local hum = char:FindFirstChildOfClass("Humanoid")
        if not hum then return end
        HookHumanoid(hum)
    end)
    StartCleanLoop()
end

local function EnableNoAttackAnim()
    Performance.NoAttackAnimEnabled = true
    pcall(SetupAttackAnimHook)
end

local function DisableNoAttackAnim()
    Performance.NoAttackAnimEnabled = false
    if Performance.CleanLoopThread then
        pcall(function() task.cancel(Performance.CleanLoopThread) end)
        Performance.CleanLoopThread = nil
    end
end

