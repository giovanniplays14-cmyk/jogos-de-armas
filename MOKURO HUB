-- ==================== SKILL KEYS PARSER ====================
local DigitMap = {
    ["1"] = Enum.KeyCode.One, ["2"] = Enum.KeyCode.Two, ["3"] = Enum.KeyCode.Three,
    ["4"] = Enum.KeyCode.Four, ["5"] = Enum.KeyCode.Five, ["6"] = Enum.KeyCode.Six,
    ["7"] = Enum.KeyCode.Seven, ["8"] = Enum.KeyCode.Eight, ["9"] = Enum.KeyCode.Nine,
    ["0"] = Enum.KeyCode.Zero,
}

local function ParseSkillKeys(str, globalDelay)
    local entries = {}
    for token in string.gmatch(str, "[^,%s]+") do
        local keyPart, delayPart = token:match("([^:]+):?([^:]*)")
        if keyPart and keyPart ~= "" then
            local upper = string.upper(keyPart)
            local keyCode = DigitMap[upper] or Enum.KeyCode[upper]
            if keyCode then
                local delay = tonumber(delayPart) or globalDelay or 0.05
                if delay < 0.01 then delay = 0.01 end
                table.insert(entries, { keyCode = keyCode, delay = delay })
            end
        end
    end
    return entries
end

local function SpamAllSkills()
    if not Skills.NoCooldownEnabled then return end
    if not Skills.LoopRunning then return end
    local entries = ParseSkillKeys(Skills.SkillKeysStr, Skills.PerSkillDelay)
    for _, entry in ipairs(entries) do
        if not Skills.NoCooldownEnabled then return end
        pcall(function()
            VirtualInputManager:SendKeyEvent(true, entry.keyCode, false, game)
            task.wait(entry.delay)
            VirtualInputManager:SendKeyEvent(false, entry.keyCode, false, game)
        end)
        task.wait(entry.delay)
    end
end

local function StartNoCooldownLoop()
    if Skills.LoopThread then
        pcall(function() task.cancel(Skills.LoopThread) end)
        Skills.LoopThread = nil
    end
    Skills.LoopRunning = true
    Skills.LoopThread = task.spawn(function()
        while Skills.NoCooldownEnabled and Skills.LoopRunning do
            pcall(SpamAllSkills)
            task.wait(math.max(0.05, Skills.CooldownInterval))
        end
        Skills.LoopRunning = false
        Skills.LoopThread = nil
    end)
end

local function StopNoCooldownLoop()
    Skills.NoCooldownEnabled = false
    Skills.LoopRunning = false
    if Skills.LoopThread then
        pcall(function() task.cancel(Skills.LoopThread) end)
        Skills.LoopThread = nil
    end
    for _, kc in pairs(DigitMap) do pcall(function() VirtualInputManager:SendKeyEvent(false, kc, false, game) end) end
    for _, name in ipairs({"Z","X","C","V","F","Q","E","R","T","G","B","H","Y","U","I","O","P"}) do
        local kc = Enum.KeyCode[name]
        if kc then pcall(function() VirtualInputManager:SendKeyEvent(false, kc, false, game) end) end
    end
end

local function SetNoCooldownState(enabled)
    Skills.NoCooldownEnabled = enabled
    if enabled then
        StartNoCooldownLoop()
    else
        StopNoCooldownLoop()
    end
    return enabled
end

