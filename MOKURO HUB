-- ==================== FOV GEOMETRY ====================
local FOVGeometry = {}

function FOVGeometry:GetAspectRatio()
    if AimAssist.FOVShape == "Circulo" then return 1 end
    local w, h = 16, 9
    if AimAssist.FOVAspect == "Personalizado" then
        w = math.max(1, tonumber(AimAssist.FOVCustomW) or 1024)
        h = math.max(1, tonumber(AimAssist.FOVCustomH) or 768)
    else
        local a, b = tostring(AimAssist.FOVAspect):match("(%d+):(%d+)")
        if a and b then w, h = tonumber(a), tonumber(b) end
    end
    return h / w
end

function FOVGeometry:GetSize(radius)
    if AimAssist.FOVShape == "Circulo" then
        return radius * 2, radius * 2, false
    end
    local hw = radius
    local hh = radius * self:GetAspectRatio()
    return hw * 2, hh * 2, true
end

function FOVGeometry:Contains(center, screenX, screenY, radius)
    local dx = screenX - center.X
    local dy = screenY - center.Y
    if AimAssist.FOVShape == "Circulo" then
        return (dx*dx + dy*dy) <= (radius*radius)
    end
    local hw = radius
    local hh = radius * self:GetAspectRatio()
    return math.abs(dx) <= hw and math.abs(dy) <= hh
end

function FOVGeometry:NormalizedDistance(center, screenX, screenY, radius)
    local dx = screenX - center.X
    local dy = screenY - center.Y
    if AimAssist.FOVShape == "Circulo" then
        return math.sqrt(dx*dx + dy*dy) / math.max(radius, 0.001)
    end
    local hw = radius
    local hh = radius * self:GetAspectRatio()
    local nx = math.abs(dx) / math.max(hw, 0.001)
    local ny = math.abs(dy) / math.max(hh, 0.001)
    return math.max(nx, ny)
end

