        local function ParseEditorString(str)
            local result = {}
            for token in string.gmatch(str, "[^,%s]+") do
                local keyPart, delayPart = token:match("([^:]+):?([^:]*)")
                if keyPart and keyPart ~= "" then
                    local delay = tonumber(delayPart)
                    table.insert(result, { key = string.upper(keyPart), delay = delay })
                end
            end
            return result
        end

        local function BuildEditorString(entries)
            local parts = {}
            for _, e in ipairs(entries) do
                if e.delay then
                    table.insert(parts, e.key .. ":" .. string.format("%.2f", e.delay))
                else
                    table.insert(parts, e.key)
                end
            end
            return table.concat(parts, ",")
        end

