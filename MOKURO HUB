                        local humanoid = char:FindFirstChildOfClass("Humanoid")
                        if humanoid then
                            for _, track in ipairs(humanoid:GetPlayingAnimationTracks()) do
                                if not IsProtected(track.Animation.AnimationId) then
                                    if Performance.InstantSkillActive then
                                        track:AdjustSpeed(100)
                                    end
                                    if Performance.NoAnimActive then
                                        track:AdjustWeight(0)
                                    end
                                end
                            end
                        end
                    end
                end
                if Performance.AntiCamActive then
                    local subject = Workspace.CurrentCamera.CameraSubject
                    local char = LocalPlayer.Character
                    if subject and char then
                        local isMyChar = (subject == char or subject.Parent == char)
                        local hasHumanoid = subject:FindFirstChildOfClass("Humanoid")
                        if not isMyChar or not hasHumanoid then
                            local myHumanoid = char:FindFirstChildOfClass("Humanoid")
                            if myHumanoid then
                                Workspace.CurrentCamera.CameraSubject = myHumanoid
                                Workspace.CurrentCamera.CameraType = Enum.CameraType.Custom
                            end
                        end
                    end
                end
            end
        end)

        RefreshPerfStatus()

        -- DESEMPENHO TAB (Fog)
        local des = TabContents["Desempenho"]

        local desHint = Instance.new("TextLabel")
        desHint.Size = UDim2.new(1, 0, 0, 60)
        desHint.BackgroundTransparency = 1
        desHint.Text = "Ajustes visuais locais: remover neblina e reduzir efeitos/sombras para aliviar o processamento. Isso não força o carregamento de partes distantes do mapa; a distância de streaming depende das configurações do jogo no Studio."
        desHint.TextColor3 = Colors.TextDark
        desHint.TextSize = 11
        desHint.TextWrapped = true
        desHint.Font = Enum.Font.Gotham
        desHint.Parent = des

        local desStatus = Instance.new("TextLabel")
        desStatus.Size = UDim2.new(1, 0, 0, 26)
        desStatus.BackgroundTransparency = 1
        desStatus.Text = "Status: fog ativo"
        desStatus.TextColor3 = Colors.TextDark
        desStatus.TextSize = 12
        desStatus.Font = Enum.Font.GothamSemibold
        desStatus.TextXAlignment = Enum.TextXAlignment.Left
        desStatus.Parent = des

        local function RefreshDesStatus()
            if Desempenho.FogDisabled then
                desStatus.Text = "Status: fog desativado"
                desStatus.TextColor3 = Colors.Success
            else
                desStatus.Text = "Status: fog ativo"
                desStatus.TextColor3 = Colors.TextDark
            end
        end

        CreateToggle(des, "Desativar Fog", Desempenho.FogDisabled, function(s)
            Desempenho.FogDisabled = s
            ApplyFog(s)
            RefreshDesStatus()
        end, "Performance_FogDisabled")

        CreateToggle(des, "Modo gráficos leve (menos efeitos e sombras)", Desempenho.GraphicsMode, function(s)
            ApplyGraphicsMode(s)
        end, "Performance_GraphicsMode")

        RefreshDesStatus()

        -- ATALHOS TAB
        local at = TabContents["Atalhos"]
        local hint = Instance.new("TextLabel")
        hint.Size = UDim2.new(1, 0, 0, 50)
        hint.BackgroundTransparency = 1
        hint.Text = "Clique em DEFINIR TECLA e pressione uma tecla. Teclas usadas pelo NC de Skills são bloqueadas aqui para evitar conflito."
        hint.TextColor3 = Colors.Text
        hint.TextSize = 11
        hint.TextWrapped = true
        hint.Font = Enum.Font.Gotham
        hint.Parent = at

        local shortcutStatus = Instance.new("TextLabel")
        shortcutStatus.Size = UDim2.new(1, 0, 0, 22)
        shortcutStatus.BackgroundTransparency = 1
        shortcutStatus.Text = ""
        shortcutStatus.TextColor3 = Colors.Warning
        shortcutStatus.TextSize = 11
        shortcutStatus.Font = Enum.Font.GothamSemibold
        shortcutStatus.TextXAlignment = Enum.TextXAlignment.Left
        shortcutStatus.Parent = at

        local resetShortcutsBtn = Instance.new("TextButton")
        resetShortcutsBtn.Size = UDim2.new(1, 0, 0, 38)
        resetShortcutsBtn.BackgroundColor3 = Color3.fromRGB(180, 40, 40)
        resetShortcutsBtn.BorderSizePixel = 0
        resetShortcutsBtn.Text = "REDEFINIR TODOS OS ATALHOS"
        resetShortcutsBtn.TextColor3 = Colors.Text
        resetShortcutsBtn.TextSize = 12
        resetShortcutsBtn.Font = Enum.Font.GothamBold
        resetShortcutsBtn.Parent = at
        CreateCorner(resetShortcutsBtn, UDim.new(0, 6))

        local function ClearAllBindings()
            for _, entry in pairs(ShortcutBindings) do
                if entry.conn then pcall(function() entry.conn:Disconnect() end) end
            end
            ShortcutBindings = {}
        end

        resetShortcutsBtn.MouseButton1Click:Connect(function()
            ClearAllBindings()
            shortcutStatus.Text = "Atalhos redefinidos."
            shortcutStatus.TextColor3 = Colors.Warning
            task.delay(2, function() shortcutStatus.Text = "" end)
        end)

        -- SETTINGS TAB
        local st = TabContents["Settings"]
        local stHint = Instance.new("TextLabel")
        stHint.Size = UDim2.new(1, 0, 0, 40)
        stHint.BackgroundTransparency = 1
        stHint.Text = "Gerencie o save do hub. O Insert esconde a interface."
        stHint.TextColor3 = Colors.Text
        stHint.TextSize = 11
        stHint.TextWrapped = true
        stHint.Font = Enum.Font.Gotham
        stHint.Parent = st

        local resetBtn = Instance.new("TextButton")
        resetBtn.Size = UDim2.new(1, 0, 0, 40)
        resetBtn.BackgroundColor3 = Colors.Accent
        resetBtn.BorderSizePixel = 0
        resetBtn.Text = "RESETAR CONFIGURAÇÕES"
        resetBtn.TextColor3 = Colors.Text
        resetBtn.TextSize = 13
        resetBtn.Font = Enum.Font.GothamBold
        resetBtn.Parent = st
        CreateCorner(resetBtn, UDim.new(0, 6))
        resetBtn.MouseButton1Click:Connect(function()
            SaveSystem:Reset()
            resetBtn.Text = "RESETADO! REABRA O HUB"
            resetBtn.BackgroundColor3 = Colors.Success
            task.delay(2, function() resetBtn.Text = "RESETAR CONFIGURAÇÕES"; resetBtn.BackgroundColor3 = Colors.Accent end)
        end)

        -- INITIALIZATION
        SetupInsertMinimize()

        pcall(function()
            FOV_Circle = Drawing.new("Circle")
            FOV_Circle.Visible = false
            FOV_Circle.Thickness = 2
        end)
        pcall(function()
            FOV_Rect = Drawing.new("Square")
            FOV_Rect.Visible = false
            FOV_Rect.Filled = false
        end)

        for _, p in ipairs(Players:GetPlayers()) do CreateESP(p) end
        Players.PlayerAdded:Connect(CreateESP)
        Players.PlayerRemoving:Connect(RemoveESP)

        Connection = RunService.RenderStepped:Connect(function()
            pcall(ApplyAimAssist)
            pcall(UpdateESP)
            pcall(UpdateMovement)
        end)

        UserInputService.InputBegan:Connect(function(input, gp)
            if gp then return end
            if input.UserInputType == Enum.UserInputType.MouseButton1 then
                IsShooting = true
                LastClickTime = tick()
            end
        end)
        UserInputService.InputEnded:Connect(function(input, gp)
            if gp then return end
            if input.UserInputType == Enum.UserInputType.MouseButton1 then
                IsShooting = false
            end
        end)

        if Movement.Enabled then
            task.spawn(function()
                LocalPlayer.CharacterAdded:Wait()
                SetupMovement()
            end)
        end
    end)

    if not success then
        warn("[Mokuro Hub] Erro ao criar interface: " .. tostring(err))
        Env.ESPMokuroRunning = nil
    end
end

CreateInterface()
print("[Mokuro Hub] Iniciado com sucesso.")
