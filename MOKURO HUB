            CreateCorner(of, UDim.new(0, 6))
            local function Close() of.Visible = false; if openDropdown == of then openDropdown = nil end end
            local function Rebuild()
                for _, ch in ipairs(of:GetChildren()) do if ch:IsA("TextButton") then ch:Destroy() end end
                of.Size = UDim2.new(0, 180, 0, math.min(#options * 32, 192))
                of.CanvasSize = UDim2.new(0, 0, 0, #options * 32)
                for i, o in ipairs(options) do
                    local ob = Instance.new("TextButton")
                    ob.Size = UDim2.new(1, -8, 0, 28)
                    ob.Position = UDim2.new(0, 4, 0, (i-1) * 32 + 2)
                    ob.BackgroundColor3 = Colors.Background
                    ob.BorderSizePixel = 0
                    ob.Text = tostring(o)
                    ob.TextColor3 = o == sb.Text and Colors.Accent or Colors.Text
                    ob.TextSize = 11
                    ob.Font = Enum.Font.GothamSemibold
                    ob.ZIndex = 101
                    ob.Parent = of
                    CreateCorner(ob, UDim.new(0, 4))
                    ob.MouseButton1Click:Connect(function()
                        sb.Text = tostring(o)
                        pcall(callback, o)
                        if saveKey then SaveCurrentConfig() end
                        Close()
                    end)
                end
            end
            Rebuild()
            if isP then
                local rb = Instance.new("TextButton")
                rb.Size = UDim2.new(0, 28, 0, 28)
                rb.Position = UDim2.new(1, -38, 0.5, -14)
