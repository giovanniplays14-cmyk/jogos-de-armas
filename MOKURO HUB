local function SavePostEffect(effect)
    if not Desempenho.OriginalPostEffects[effect] then
        local ok, enabled = pcall(function() return effect.Enabled end)
        if ok then Desempenho.OriginalPostEffects[effect] = enabled end
    end
end

local function ApplyGraphicsMode(enabled)
    Desempenho.GraphicsMode = enabled

    if Desempenho.OriginalTerrainDecoration == nil then
        pcall(function()
            Desempenho.OriginalTerrainDecoration = Workspace.Terrain.Decoration
        end)
    end

    if enabled then
        pcall(function() Lighting.GlobalShadows = false end)
        pcall(function() Workspace.Terrain.Decoration = false end)
        for _, obj in ipairs(Lighting:GetDescendants()) do
            if obj:IsA("PostEffect") then
                SavePostEffect(obj)
                pcall(function() obj.Enabled = false end)
            end
        end
    else
        pcall(function() Lighting.GlobalShadows = Desempenho.OriginalGlobalShadows end)
        if Desempenho.OriginalTerrainDecoration ~= nil then
            pcall(function() Workspace.Terrain.Decoration = Desempenho.OriginalTerrainDecoration end)
        end
        for effect, wasEnabled in pairs(Desempenho.OriginalPostEffects) do
            if effect and effect.Parent then
                pcall(function() effect.Enabled = wasEnabled end)
            end
        end
    end
end

