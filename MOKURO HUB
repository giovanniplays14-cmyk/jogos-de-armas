                rb.ZIndex = 4
                rb.Parent = f
                CreateCorner(rb, UDim.new(0, 4))
                rb.MouseButton1Click:Connect(function()
                    local cur = sb.Text
                    table.clear(options)
                    table.insert(options, "Automático")
                    for _, p in ipairs(Players:GetPlayers()) do if p ~= LocalPlayer then table.insert(options, p.Name) end end
                    if cur ~= "Automático" and not table.find(options, cur) then
                        cur = "Automático"
                        sb.Text = cur
                        pcall(callback, cur)
                    end
                    Rebuild()
                    rb.Text = "✓"
                    task.delay(0.7, function() if rb and rb.Parent then rb.Text = "R" end end)
                end)
            end
            sb.MouseButton1Click:Connect(function()
                if of.Visible then Close(); return end
                if openDropdown and openDropdown ~= of then openDropdown.Visible = false end
                local p = sb.AbsolutePosition
                local vp = Camera and Camera.ViewportSize or Vector2.new(800, 600)
                local ph = of.AbsoluteSize.Y
                local y = p.Y + sb.AbsoluteSize.Y + 4
                if y + ph > vp.Y then y = math.max(4, p.Y - ph - 4) end
                of.Position = UDim2.fromOffset(math.clamp(p.X, 4, math.max(4, vp.X - 184)), y)
                of.Visible = true
                openDropdown = of
            end)
            if saveKey then UIRefs.Dropdowns[saveKey] = { Set = function(v) sb.Text = tostring(v) end } end
            return f
        end

