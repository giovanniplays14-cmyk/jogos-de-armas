    if has then return sp end
    if AimAssist.LowestHealthPriority then LockedTarget = nil; return GetPlayerWithLowestHealth()
    elseif AimAssist.PriorityMode == "Distance" then return GetClosestPlayerByDistance()
    else return GetClosestPlayerByFOV() end
end

local function ApplyAimAssist()
    local should = AimAssist.Enabled and (AimAssist.AlwaysOn or not AimAssist.ShootToActivate or IsShooting)
    if not should then
        CurrentTarget = nil
        LockedTarget = nil
        return
    end
    if not LocalPlayer.Character then return end
    local myHum = LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
    if not myHum or myHum.Health <= 0 then return end
    CurrentTarget = GetClosestPlayer()
    if CurrentTarget and CurrentTarget.Character then
        local tp = GetTargetPart(CurrentTarget.Character)
        if tp then
            local targetPos = tp.Position
            if tp.Name == "Head" then targetPos = targetPos + Vector3.new(0, 0.75, 0) end
            local ccf = Camera.CFrame
            local tcf
            if AimAssist.AimReference == "Cursor" or AimAssist.CustomAimActive then
                local ref = GetAimReferencePoint()
                local ray = Camera:ScreenPointToRay(ref.X, ref.Y)
                local dr = ray.Direction.Unit
                local td = (targetPos - ccf.Position).Unit
                local dot = math.clamp(dr:Dot(td), -1, 1)
                local axis = dr:Cross(td)
                if axis.Magnitude > 1e-5 then
                    local rd = CFrame.fromAxisAngle(axis.Unit, math.acos(dot))
                    local cr = ccf - ccf.Position
                    tcf = CFrame.new(ccf.Position) * rd * cr
                else
                    tcf = ccf
                end
            else
                tcf = CFrame.lookAt(ccf.Position, targetPos)
            end
            local ok, sp = pcall(function() return Camera:WorldToViewportPoint(targetPos) end)
            if ok then
                local ar = GetAimReferencePoint()
                local dfc = (Vector2.new(sp.X, sp.Y) - ar).Magnitude
                local smooth
                if dfc < 25 then smooth = AimAssist.SnapSmoothness
                elseif dfc < 80 then smooth = 0.92
                elseif AimAssist.MagnetMode then smooth = 0.88
                else smooth = AimAssist.Smoothness end
                Camera.CFrame = ccf:Lerp(tcf, smooth)
            end
        end
    else
        LockedTarget = nil
    end
end

