}

local function SaveAtmosphere(atmosphere)
    if not Desempenho.OriginalAtmospheres[atmosphere] then
        Desempenho.OriginalAtmospheres[atmosphere] = {
            Density = atmosphere.Density,
            Haze = atmosphere.Haze,
            Glare = atmosphere.Glare,
            Color = atmosphere.Color,
            Decay = atmosphere.Decay,
            Offset = atmosphere.Offset,
        }
    end
end

local function ApplyFog(disabled)
    Desempenho.FogDisabled = disabled

    if disabled then
        -- Neblina clássica
        Lighting.FogStart = 0
        Lighting.FogEnd = 1000000

        -- Neblina criada por Atmosphere
        for _, obj in ipairs(Lighting:GetDescendants()) do
            if obj:IsA("Atmosphere") then
                SaveAtmosphere(obj)
                obj.Density = 0
                obj.Haze = 0
                obj.Glare = 0
            end
        end
    else
        -- Restaurar neblina clássica
        Lighting.FogStart = Desempenho.OriginalFogStart
        Lighting.FogEnd = Desempenho.OriginalFogEnd
        Lighting.FogColor = Desempenho.OriginalFogColor

        -- Restaurar Atmospheres que foram alterados
        for atmosphere, original in pairs(Desempenho.OriginalAtmospheres) do
            if atmosphere and atmosphere.Parent then
                atmosphere.Density = original.Density
                atmosphere.Haze = original.Haze
                atmosphere.Glare = original.Glare
                atmosphere.Color = original.Color
                atmosphere.Decay = original.Decay
                atmosphere.Offset = original.Offset
            end
        end
    end
end

-- Aplicar também a Atmosphere que o jogo adicionar depois
Lighting.DescendantAdded:Connect(function(obj)
    if obj:IsA("Atmosphere") and Desempenho.FogDisabled then
        SaveAtmosphere(obj)
        obj.Density = 0
        obj.Haze = 0
        obj.Glare = 0
    end
end)

if Desempenho.FogDisabled then
    task.defer(function() ApplyFog(true) end)
end

